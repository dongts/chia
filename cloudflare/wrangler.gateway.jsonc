{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chia",
  "main": "src/gateway.mjs",
  "account_id": "71f0645d95a495c65a6261f599afaa2c",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [],
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "python3 scripts/prepare.py"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*",
      "/health",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-protected-resource*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chia-production-20260918",
      "database_id": "4e0d3fcc-96fa-453a-983f-124a0f9d3383",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "chia-production-uploads"
    }
  ],
  "vars": {
    "CHIA_ENV": "production",
    "CHIA_CORS_ORIGINS": "[\"https://chia.dongtran.asia\", \"https://localhost\", \"http://localhost\", \"capacitor://localhost\"]",
    "CHIA_READ_ONLY": "false",
    "CHIA_NATIVE_ORIGIN": "https://mcp.chia.dongtran.asia"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "chia.dongtran.asia",
      "custom_domain": true
    },
    {
      "pattern": "api.chia.dongtran.asia",
      "custom_domain": true
    }
  ]
}
